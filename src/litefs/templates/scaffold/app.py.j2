#!/usr/bin/env python
# coding: utf-8

"""
${project_name} - Litefs 应用
"""

from litefs.core import Litefs


# 创建应用实例
# 配置全部来自 config.yaml，其中 middleware 配置项控制自动挂载的内置中间件，
# 同名配置段（如 cors: / health_check:）作为对应中间件的构造参数
app = Litefs(config_file='config.yaml')


# 挂载静态文件目录
app.add_static('/static', 'static')


# 定义默认首页处理函数
def index_handler(request):
    """
    处理首页请求

    Args:
        request: 请求对象

    Returns:
        str: 响应内容（以 < 开头的字符串自动以 text/html 输出）
    """
    with open('templates/index.html', 'r', encoding='utf-8') as f:
        return f.read()


# 定义关于页面处理函数
def about_handler(request):
    """
    处理关于页面请求

    Args:
        request: 请求对象

    Returns:
        str: 响应内容（以 < 开头的字符串自动以 text/html 输出）
    """
    with open('templates/about.html', 'r', encoding='utf-8') as f:
        return f.read()


# 定义 API 接口处理函数
def api_handler(request):
    """
    处理 API 请求

    Args:
        request: 请求对象

    Returns:
        dict: 响应数据（自动序列化为 application/json）
    """
    return {
        "name": "${project_name}",
        "version": "1.0.0",
        "status": "ok",
        "message": "Welcome to the API!",
    }


# 添加路由
app.add_get('/', index_handler, name='index')
app.add_get('/about', about_handler, name='about')
app.add_get('/api', api_handler, name='api')


if __name__ == "__main__":
    app.run()
